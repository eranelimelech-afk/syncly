project.manifest = manifest.xml

# Base resources (strings, settings, drawables). resources-heb/ overlays
# Hebrew strings automatically for devices set to Hebrew.
base.resourcePath = resources

# Custom bitmap fonts (spec section 4: Barlow Semi Condensed, tabular
# figures, one .fnt per size). Fonts are fixed-pixel, so each screen
# resolution gets its own scaled set, generated by tools/gen_fonts.py.
fenix8pro47mm.resourcePath = $(base.resourcePath);resources-scale454
fenix847mm.resourcePath = $(base.resourcePath);resources-scale454
fenix843mm.resourcePath = $(base.resourcePath);resources-scale416
fenix8solar47mm.resourcePath = $(base.resourcePath);resources-scale260
fenix8solar51mm.resourcePath = $(base.resourcePath);resources-scale280
