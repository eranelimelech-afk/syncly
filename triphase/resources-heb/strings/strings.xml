<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hebrew overlay (spec section 10). Phone-app setting titles are translated;
  the Connect IQ mobile app renders Hebrew correctly. On-watch field labels
  deliberately KEEP the English single-word tokens until a Hebrew bitmap font
  (27 letters + digits) is generated and validated on hardware - the simulator
  does not draw Hebrew glyphs, so a Hebrew watch layout cannot be verified
  before sideloading. Every id from the English file is defined here (the
  compiler warns on any id missing for a declared language). Titles are short
  phrases with no mixed direction, since Monkey C performs no bidi reordering.
-->
<resources>
    <strings>
        <string id="AppName">TriPhase</string>
        <string id="WeekPrefix">· WEEK</string>

        <!-- On-watch labels: English tokens on purpose (no Hebrew watch font yet) -->
