<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hebrew overlay (spec section 10). Deliberately limited to phone-app setting
  titles, which the Connect IQ mobile app renders correctly. On-watch labels
  fall back to the English single-word tokens until a Hebrew bitmap font
  (27 letters + digits) is generated and validated on hardware - the simulator
  does not draw Hebrew glyphs, so a Hebrew watch layout cannot be verified
  before sideloading. Every title is kept to a short phrase with no mixed
  direction, since Monkey C performs no bidi reordering.
-->
