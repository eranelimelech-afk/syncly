<?xml version="1.0" encoding="UTF-8"?>
<!--
  TriPhase watch face - Garmin fenix 8 / fenix 8 Pro.

  Product ids verified against Connect IQ SDK 9.2.0 (resources/device-reference)
  and Garmin's compatible-devices page: there is deliberately no "fenix8pro51mm"
  or "fenix851mm" id. Garmin groups same-resolution variants under one id:
    - fenix8pro47mm covers fenix 8 Pro 47mm, Pro 51mm, Pro MicroLED
      (and quatix 8 Pro), all 454x454 AMOLED
    - fenix847mm covers fenix 8 47mm and 51mm (and tactix/quatix 8), 454x454
  fenix 8 and later silently hide a face whose device id is absent here, so
  re-verify this list when a new SDK revision lands.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="8f2a41d7c3b94e6a9d5f2b7a1c0e4d93"
        type="watchface"
        name="@Strings.AppName"
        entry="TriPhaseApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="5.0.0">
        <iq:products>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="ComplicationSubscriber"/>
            <iq:uses-permission id="SensorHistory"/>
            <iq:uses-permission id="UserProfile"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>heb</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
