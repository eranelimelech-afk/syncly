<?xml version="1.0" encoding="UTF-8"?>
<!--
  TriPhase watch face - Garmin fenix 8 / fenix 8 Pro.

  NOTE (spec section 13): the product id strings below follow the build spec and
  MUST be verified against the installed SDK's devices.xml before release.
  fenix 8 and later silently hide a face whose device id is absent here.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="8f2a41d7c3b94e6a9d5f2b7a1c0e4d93"
        type="watchface"
        name="@Strings.AppName"
        entry="TriPhaseApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="5.0.0">
        <iq:products>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenix8pro51mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix851mm"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Complications"/>
            <iq:uses-permission id="SensorHistory"/>
            <iq:uses-permission id="UserProfile"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>heb</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
